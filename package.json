{
  "name": "mcp-authprobe",
  "version": "0.8.0",
  "mcpName": "io.github.Enigmacker/mcp-authprobe",
  "description": "Active authorization testing for remote MCP servers you own: refresh token rotation, redirect_uri strictness and more, as a CLI and an MCP server.",
  "license": "MIT",
  "author": "Enigmacker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enigmacker/mcp-authprobe.git"
  },
  "bugs": {
    "url": "https://github.com/Enigmacker/mcp-authprobe/issues"
  },
  "homepage": "https://github.com/Enigmacker/mcp-authprobe#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "security",
    "scanner",
    "sarif"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "mcp-authprobe": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node docs/demo/record.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "node-html-parser": "^9.0.6",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.10.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
